    local function CheckCheater(player)
        if player == LocalPlayer then return end
        if DetectionSettings.CheatDetector and not Cheaters[player.Name] then
            local pStats = ReplicatedStorage:FindFirstChild("Players")
            if pStats then pStats = pStats:FindFirstChild(player.Name) end
            if pStats then
                local status = pStats:FindFirstChild("Status")
                if status then
                    local journey = status:FindFirstChild("Journey")
                    if journey then
                        local wipe = journey:FindFirstChild("WipeStatistics")
                        if wipe then
                            local deaths = wipe:GetAttribute("Deaths") or 0
                            if deaths == 0 then deaths = 1 end
                            local kills = wipe:GetAttribute("Kills") or 0
                            if kills == 0 then kills = 1 end
                            
                            local kdr = math.floor(kills / deaths * 10) / 10
                            
                            local reportList = ReplicatedStorage:FindFirstChild("ReportList")
                            if reportList then
                                local rData = reportList.MostWanted:FindFirstChild(player.Name) or reportList.Recent:FindFirstChild(player.Name)
                                if rData then
                                    local totalFlags = rData:GetAttribute("TotalFlags") or 0
                                    local hsr = rData:GetAttribute("HSR") or 0
                                    local age = rData:GetAttribute("Age") or 0
                                    
                                    if 15 <= kills and 95 <= hsr then
                                        Cheaters[player.Name] = true
                                        notifySpam("Cheat | Detector (B) (KDR: " .. kdr .. ")", "Player: " .. player.Name .. " Has been suspected for Cheating!", 1, 5)
                                    end
                                    if 75 <= totalFlags and age <= 50 then
                                        Cheaters[player.Name] = true
                                        notifySpam("Cheat | Detector (C) (KDR: " .. kdr .. ")", "Player: " .. player.Name .. " Has been suspected for Cheating!", 1, 5)
                                    end
                                end
                            end
                            if 15 <= kills and kdr and 5 <= kdr then
                                Cheaters[player.Name] = true
                                notifySpam("Cheat | Detector (A) (KDR: " .. kdr .. ")", "Player: " .. player.Name .. " Has been suspected for Cheating!", 1, 5)
                            end
                        end
                    end
                end
            end
        end
    end

