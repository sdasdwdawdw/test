    -- Helper: set all icon parts to a color
    local function setIconColor(tab, color, animate)
        local info = TweenInfo.new(0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
        for _, f in ipairs(tab.IconFrames or {}) do
            if animate then
                TweenService:Create(f, info, {BackgroundColor3 = color}):Play()
            else
                f.BackgroundColor3 = color
            end
        end
        for _, s in ipairs(tab.IconStrokes or {}) do
            if animate then
                TweenService:Create(s, info, {Color = color}):Play()
            else
                s.Color = color
            end
        end
        for _, t in ipairs(tab.IconTexts or {}) do
            if animate then
                TweenService:Create(t, info, {TextColor3 = color}):Play()
            else
                t.TextColor3 = color
            end
        end
        for _, img in ipairs(tab.IconImages or {}) do
            if animate then
                TweenService:Create(img, info, {ImageColor3 = color}):Play()
            else
                img.ImageColor3 = color
            end
        end
    end

