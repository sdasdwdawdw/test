        ["HumanoidRootPart"] = {"HumanoidRootPart"}
    }

    local function getPartFromRig(character, partName)
        local part = character:FindFirstChild(partName)
        if part then return part end
        if r15Mapping[partName] then
            for _, r15Name in ipairs(r15Mapping[partName]) do
                part = character:FindFirstChild(r15Name)
                if part then return part end
            end
        end
        return nil
    end

    local function getClosestBodyPart(character)
        local mousePos = UserInputService:GetMouseLocation()
        local bestPart = nil
        local bestDist = math.huge
        local bodyParts = {"Head", "Torso", "Left Arm", "Right Arm", "Left Leg", "Right Leg"}
        for _, partName in ipairs(bodyParts) do
            local part = getPartFromRig(character, partName)
            if part then
                local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
                if onScreen then
                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                    if dist < bestDist then
                        bestDist = dist
                        bestPart = part
                    end
                end
            end
        end
        return bestPart
    end

    local function resolveTargetPart(character, settings)
        local targetParts = settings.TargetParts
        if not targetParts then return getPartFromRig(character, "Head") end
        
        local mousePos = UserInputService:GetMouseLocation()
        local bestPart = nil
        local bestDist = math.huge
        
        for partName, enabled in pairs(targetParts) do
            if enabled then
                local part = getPartFromRig(character, partName)
                if part then
                    local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
                    if onScreen then
                        local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                        if dist < bestDist then
                            bestDist = dist
                            bestPart = part
                        end
                    end
                end
            end
        end
        
        return bestPart or getPartFromRig(character, "Head")
    end


    -- [ Removed local TracerLine to use global AimbotTracerLine/SilentTracerLine ]

    local function getClosestTarget(settings)
        local closestDist = settings.FOVSize or 150
        local closestTarget = nil
        local vSize = Camera and Camera.ViewportSize or Vector2.new(800, 600)
        local center = Vector2.new(vSize.X / 2, vSize.Y / 2)
        
        local potentialTargets = {}
        
        -- Player Targeting
        if settings.TargetPlayers then
            for _, plr in pairs(game:GetService("Players"):GetPlayers()) do
                if plr ~= LocalPlayer and plr.Character then 
                    table.insert(potentialTargets, { Character = plr.Character, Origin = plr }) 
                end
            end
        end

        -- NPC Targeting
        if settings.TargetNPCs and Workspace:FindFirstChild("AiZones") then
            for _, zone in pairs(Workspace.AiZones:GetChildren()) do
                for _, npc in pairs(zone:GetChildren()) do
                    if npc:IsA("Model") then 
                        table.insert(potentialTargets, { Character = npc, Origin = npc }) 
                    end
                end
            end
        end
        
        local lpChar = LocalPlayer.Character
        local lpRoot = lpChar and lpChar:FindFirstChild("HumanoidRootPart")
        if not lpRoot then return nil end
        local lpPos = lpRoot.Position
        local droppedItems = Workspace:FindFirstChild("DroppedItems")

        -- Aggressive Part Check List
        local checkParts = {"Head", "UpperTorso", "LowerTorso", "LeftUpperArm", "RightUpperArm", "LeftUpperLeg", "RightUpperLeg", "Torso", "Left Arm", "Right Arm", "Left Leg", "Right Leg"}

        for _, target in ipairs(potentialTargets) do
            local char = target.Character
            if char and char.Parent ~= droppedItems then
                local hum = char:FindFirstChild("Humanoid")
                local hrp = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
                
                if hum and hum.Health > 0 and hrp then
                    -- World Distance Check (Ensure NO mobile-specific limit)
                    local worldDist = (lpPos - hrp.Position).Magnitude
                    local maxDist = settings.MaxDistance or 2000
                    if worldDist > maxDist then continue end

                    -- Aggressive Detection: Check if ANY part is in FOV
                    local anyPartInFOV = false
                    local bestPartDist = math.huge
                    local selectedPart = nil

                    for _, pName in ipairs(checkParts) do
                        local part = char:FindFirstChild(pName)
                        if part and part:IsA("BasePart") then
                            local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
                            if onScreen then
                                local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                                if dist <= closestDist then
                                    anyPartInFOV = true
                                    if dist < bestPartDist then
                                        bestPartDist = dist
                                        selectedPart = part
                                    end
                                end
                            end
                        end
                    end

                    if anyPartInFOV and selectedPart then
                        if settings.WallCheck and not isVisible(selectedPart) then continue end
                        closestDist = bestPartDist
                        closestTarget = target
                        -- Store the targeted part for the hook to use
                        target.SelectedPart = selectedPart
                    end
                end
            end
        end
        return closestTarget
    end

