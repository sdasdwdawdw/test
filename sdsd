                    VisorCache.Visor = screenEffects.Visor.Visible
                    VisorCache.Mask = screenEffects.Mask.Visible
                    VisorCache.HelmetMask = screenEffects.HelmetMask.Visible
                    VisorCache.Flashbang = screenEffects.Flashbang.Visible
                end

                if state then
                    -- Force hide
                    screenEffects.Visor.Visible = false
                    screenEffects.HelmetMask.Visible = false
                    screenEffects.Mask.Visible = false
                    screenEffects.Flashbang.Visible = false
                else
                    -- Restore original states
                    screenEffects.Visor.Visible = VisorCache.Visor
                    screenEffects.Mask.Visible = VisorCache.Mask
                    screenEffects.HelmetMask.Visible = VisorCache.HelmetMask
                    screenEffects.Flashbang.Visible = VisorCache.Flashbang
