-- Utility functions from implace.txt
local function Save(r0_24, r1_24)
    if typeof(r0_24) == "UDim2" then
        local r2_24 = r0_24.X.Scale .. "," .. r0_24.X.Offset .. "," .. r0_24.Y.Scale .. "," .. r0_24.Y.Offset
        if not r1_24:match("%.txt$") then
            r1_24 = r1_24 .. ".txt"
        end
        writefile(r1_24, r2_24)
    else
        writefile(r1_24, tostring(r0_24))
    end
end

local function Load(r0_291, r1_291)
    if not isfile(r1_291) then
        return nil
    end
    local r2_291 = readfile(r1_291)
    if r0_291 == "UDim2" then
        local r3_291 = {}
        for r7_291 in r2_291:gmatch("[^,]+") do
            table.insert(r3_291, tonumber(r7_291))
        end
        if #r3_291 == 4 then
            return UDim2.new(unpack(r3_291))
        end
    elseif r0_291 == "Text" then
        return r2_291
    end
    return nil
end

