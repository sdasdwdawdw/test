function ESP.updateBox(box, playerName, rootPos, humHealth, humMaxHealth, color, sBoxes, sHealth, sNames, sWeapon, sDist, nameCol, wepCol, distCol, distance, toolName)
    local V2 = ESP.V2; local fl = ESP.fl
    local root2D, onScreen = Camera:WorldToViewportPoint(rootPos)
    local depth = root2D.Z
    if not onScreen or depth < 0.1 then ESP.hideBox(box); return end
    
    local height = fl(ESP.SC.HeightFactor / (depth + 0.01))
    if height < 1 then ESP.hideBox(box); return end
    
    local width = fl(height * 0.6667)
    local cx = fl(root2D.X)
    local x = fl(cx - width * 0.5)
    local y = fl(root2D.Y - height * 0.5)
    local yh = y + height
    
    local c = box._c

    if sBoxes then
        local bm = box.BoxMain
        local newPos = V2(x, y); local newSize = V2(width, height)
        if c.bP ~= newPos then c.bP = newPos; bm.Position = newPos end
        if c.bS ~= newSize then c.bS = newSize; bm.Size = newSize end
        if c.bC ~= color then c.bC = color; bm.Color = color end
        if not c.bV then c.bV = true; bm.Transparency = 0.8; bm.Visible = true end
    else
        if c.bV then c.bV = false; box.BoxMain.Visible = false end
    end

    if sHealth then
        local bx = x - 5
        local healthPct = ESP.cl(humHealth / humMaxHealth, 0.01, 1)
        
        local hOut = box.HealthBarOutline
        local p1 = V2(bx, y); local p2 = V2(bx, yh)
        if c.ho1 ~= p1 then c.ho1 = p1; hOut.From = p1 end
        if c.ho2 ~= p2 then c.ho2 = p2; hOut.To = p2 end
        if not c.hoV then c.hoV = true; hOut.Color = ESP.BLACK; hOut.Visible = true end
        
        local barTopY = yh - fl(height * healthPct)
        local hBar = box.HealthBar
        local hp2 = V2(bx, barTopY)
        if c.hb1 ~= p2 then c.hb1 = p2; hBar.From = p2 end
        if c.hb2 ~= hp2 then c.hb2 = hp2; hBar.To = hp2 end
        
        local hCol = ESP.C3hsv(healthPct * 0.3, 1, 1)
        if c.hbC ~= hCol then c.hbC = hCol; hBar.Color = hCol end
        if not c.hbV then c.hbV = true; hBar.Visible = true end
        
        if healthPct < 0.95 then
            local ht = box.HealthText
            local hVal = ESP.ts(fl(humHealth))
            if c.htT ~= hVal then c.htT = hVal; ht.Text = hVal end
            local hTp = V2(bx, barTopY - 7)
            if c.htP ~= hTp then c.htP = hTp; ht.Position = hTp end
            if not c.htV then c.htV = true; ht.Color = ESP.WHITE; ht.Visible = true end
        else
            if c.htV then c.htV = false; box.HealthText.Visible = false end
        end
    else
        if c.hoV then c.hoV = false; box.HealthBarOutline.Visible = false end
        if c.hbV then c.hbV = false; box.HealthBar.Visible = false end
        if c.htV then c.htV = false; box.HealthText.Visible = false end
    end

    if sNames or Moderators[playerName] or Cheaters[playerName] then
        local nt = box.NameText
        local np = V2(cx, y - 16)
        local nStr = playerName
        local nCol = nameCol

        if Moderators[playerName] then 
            nStr = nStr .. " [MOD]"; nCol = ESP.C3(1, 0.84, 0)
        elseif Cheaters[playerName] then 
            nStr = nStr .. " [CHEATER]"; nCol = ESP.C3(1, 0.2, 0.2)
        end

        if c.nT ~= nStr then c.nT = nStr; nt.Text = nStr end
        if c.nP ~= np then c.nP = np; nt.Position = np end
        if c.nC ~= nCol then c.nC = nCol; nt.Color = nCol end
        if not c.nV then c.nV = true; nt.Visible = true end
    else
        if c.nV then c.nV = false; box.NameText.Visible = false end
    end

    local footerY = yh + 2
    if sWeapon and toolName ~= "None" then
        local wt = box.WepText
        local wp = V2(cx, footerY)
        if c.wT ~= toolName then c.wT = toolName; wt.Text = toolName end
        if c.wP ~= wp then c.wP = wp; wt.Position = wp end
        if c.wC ~= wepCol then c.wC = wepCol; wt.Color = wepCol end
        if not c.wV then c.wV = true; wt.Visible = true end
        footerY = footerY + 13
    else
        if c.wV then c.wV = false; box.WepText.Visible = false end
    end

    if sDist then
        local dt = box.DistText
        local dp = V2(cx, footerY)
        local dStr = ESP.ts(fl(distance * 0.25)) .. "M"
        if c.dT ~= dStr then c.dT = dStr; dt.Text = dStr end
        if c.dP ~= dp then c.dP = dp; dt.Position = dp end
        if c.dC ~= distCol then c.dC = distCol; dt.Color = distCol end
        if not c.dV then c.dV = true; dt.Visible = true end
    else
        if c.dV then c.dV = false; box.DistText.Visible = false end
    end
end

AddConnection(RunService.RenderStepped:Connect(function()
    local lpChar = LocalPlayer.Character
    local lpRoot = lpChar and lpChar:FindFirstChild("HumanoidRootPart")
    if lpRoot then
            local lpPos = lpRoot.Position
            local S = ESP.SC

            S.Boxes = ESPSettings.Boxes; S.Health = ESPSettings.Health; S.Names = ESPSettings.Names
            S.Weapon = ESPSettings.Weapon; S.Dist = ESPSettings.Distance; S.Skel = ESPSettings.Skeletons
            S.HL = ESPSettings.Highlights; S.Chams = ESPSettings.Chams; S.MaxDist = ESPSettings.MaxDistance
            S.BoxColor = ESPSettings.BoxColor; S.NameCol = ESPSettings.NameColor or ESP.WHITE
            S.WepCol = ESPSettings.WeaponColor or ESP.WHITE; S.DistCol = ESPSettings.DistanceColor or ESP.WHITE
            S.SkelCol = ESPSettings.SkeletonColor; S.HlCol = ESPSettings.HlColor; S.ChamsCol = ESPSettings.ChamsColor
            S.NeedBox = S.Boxes or S.Health or S.Names or S.Weapon or S.Dist
            local maxDistSq = S.MaxDist * S.MaxDist
            local V2 = ESP.V2
            
            local fov = Camera.FieldOfView
            S.HeightFactor = 6.4 * (Camera.ViewportSize.Y / (2 * math.tan(math.rad(fov) * 0.5)))

            for _, player in ipairs(Players:GetPlayers()) do
                if player == LocalPlayer then continue end
                local isSpecial = Moderators[player.Name] or Cheaters[player.Name]
                
                -- Skip players if ESP is off and they aren't special
                if not ESPSettings.Enabled and not isSpecial then
                    local obj = ESP.players[player]
                    if obj then ESP.hideAll(obj) end
                    continue
                end

                local char = player.Character
                if not char then
                    local obj = ESP.players[player]
                    if obj then ESP.hideAll(obj) end
                    continue
                end
                
                local obj = ESP.players[player]
                if not obj then obj = {}; ESP.players[player] = obj end

                if obj._char ~= char then
                     if obj.Chams then 
                         for _, a in ipairs(obj.Chams) do pcall(function() a:Destroy() end) end
                         obj.Chams = nil 
                     end
                     obj._char = char
                     obj._root = char:FindFirstChild("HumanoidRootPart")
                     obj._hum = char:FindFirstChild("Humanoid")
                     obj._skel = nil 
                end
                
                if not obj._root then obj._root = char:FindFirstChild("HumanoidRootPart") end
                if not obj._hum then obj._hum = char:FindFirstChild("Humanoid") end

                local root = obj._root
                local hum = obj._hum

                if not (hum and root and hum.Health > 0) then
                    ESP.hideAll(obj)
                    continue
                end
                
                local delta = lpPos - root.Position
                local distSq = delta.X * delta.X + delta.Y * delta.Y + delta.Z * delta.Z
                if distSq > maxDistSq then ESP.hideAll(obj); continue end
                
                local dist = 0
                if S.Dist then dist = distSq ^ 0.5 end
                
                local rootPos = root.Position

                if S.NeedBox or isSpecial then
                    if not obj.Box then obj.Box = ESP.createBox() end
                    ESP.updateBox(obj.Box, player.Name, rootPos, hum.Health, hum.MaxHealth, S.BoxColor, S.Boxes, S.Health, S.Names, S.Weapon, S.Dist, S.NameCol, S.WepCol, S.DistCol, dist, ESP.wepCache[player] or "None")
                elseif obj.Box then
                    ESP.hideBox(obj.Box)
                end

                if S.Skel then
                    if not obj.Skeleton then obj.Skeleton = ESP.createSkel() end
                    local sk = obj.Skeleton
                    local anyVisible = false

                    for i, bone in ipairs(ESP.Bones) do
                        local line = sk.Lines[i]
                        local p1 = getPart(char, bone[1])
                        local p2 = getPart(char, bone[2])
                        
                        if p1 and p2 then
                            local s1, v1 = Camera:WorldToViewportPoint(p1.Position)
                            local s2, v2 = Camera:WorldToViewportPoint(p2.Position)
                            
                            if v1 and v2 then
                                line.From = V2(s1.X, s1.Y)
                                line.To = V2(s2.X, s2.Y)
                                line.Color = S.SkelCol
                                line.Visible = true
                                anyVisible = true
                            else
                                line.Visible = false
                            end
                        else
                            line.Visible = false
                        end
                    end
                    sk._v = anyVisible
                elseif obj.Skeleton then
                    ESP.hideSkel(obj.Skeleton)
                end

                if S.HL then
                    if not obj.Highlight then
                        obj.Highlight = Instance.new("Highlight", CoreGui)
                        obj.Highlight.FillTransparency = 1; obj.Highlight.OutlineTransparency = 0
                    end
                    local hl = obj.Highlight
                    if hl.Adornee ~= char then hl.Adornee = char end
                    if hl.OutlineColor ~= S.HlCol then hl.OutlineColor = S.HlCol end
                    if not hl.Enabled then hl.Enabled = true end
                elseif obj.Highlight then
                    if obj.Highlight.Enabled then obj.Highlight.Enabled = false end
                end

                if S.Chams then
                    if not obj.Chams then
                        obj.Chams = {}
                        local parts = {"Head", "Torso", "Left Arm", "Right Arm", "Left Leg", "Right Leg", "UpperTorso", "LowerTorso", "LeftUpperArm", "RightUpperArm", "LeftUpperLeg", "RightUpperLeg"}
                        for _, pN in ipairs(parts) do
                            local p = char:FindFirstChild(pN)
                            if p and p:IsA("BasePart") then
                                local a = Instance.new("BoxHandleAdornment", CoreGui)
                                a.Size = (pN == "Head" and ESP.V3(1.25, 1.25, 1.25) or p.Size + ESP.V3(0.05, 0.05, 0.05))
                                a.AlwaysOnTop = true; a.ZIndex = 5; a.Transparency = 0.5
                                a.Color3 = S.ChamsCol; a.Adornee = p
                                table.insert(obj.Chams, a)
                            end
                        end
                    end
                    for _, a in ipairs(obj.Chams) do 
                        if a.Color3 ~= S.ChamsCol then a.Color3 = S.ChamsCol end
                        if not a.Visible then a.Visible = true end
                    end
                elseif obj.Chams then
                    for _, a in ipairs(obj.Chams) do 
                        if a.Visible then a.Visible = false end 
                    end
                end
            end
        end

    -- Inventory Checker Update
    if InvCheckSettings and InvCheckSettings.Enabled then
        -- Toggle button visibility based on Enabled state (Mobile Only)
        if isMobile and UIHandles.InvCheckManualBtn then
            UIHandles.InvCheckManualBtn.Visible = InvCheckSettings.Enabled
        end

        -- Check logic: Mobile uses Toggle button, PC uses Hold logic (from Registry)
        if InvCheckSettings.Active then
            local target = GetInvTarget()
            if target then
                local showFull = InvCheckSettings.Features["Show Full Inventory"]
                if showFull == nil then showFull = true end -- Enforce default if config is missing
                
                InvFrame.Visible = true
                InvValueTxt.Visible = InvCheckSettings.Features["Show Inventory Value"]
                FullGrid.Visible = showFull
                InvFrame.Size = UDim2.new(0, 480, 0, showFull and 580 or 210)
                UpdateInvIcons(target)
            else
                InvFrame.Visible = false
            end
        else
            InvFrame.Visible = false
        end
    else
        InvFrame.Visible = false
        if UIHandles.InvCheckManualBtn then UIHandles.InvCheckManualBtn.Visible = false end
    end
end))
function DeltaLib:Unload()
    ScriptUnloaded = true
    for _, conn in pairs(Connections) do
        if conn and conn.Disconnect then pcall(function() conn:Disconnect() end) end
    end
    for _, obj in pairs(Drawings) do
        if obj and obj.Remove then pcall(function() obj:Remove() end) end
    end
    -- Also handles ScreenGui destruction if needed, but usually destroying the GUI is enough
    if game.CoreGui:FindFirstChild("DeltaWhiteHub") then
        game.CoreGui.DeltaWhiteHub:Destroy()
    end
end

