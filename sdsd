                    Parent = SBtn, BackgroundColor3 = Color3.fromRGB(34, 36, 48), Size = UDim2.new(1, -24, 0, 6),
                    Position = UDim2.new(0, 12, 1, -12), BorderSizePixel = 0
                })
                Create("UICorner", { Parent = SliderBG, CornerRadius = UDim.new(1, 0) })

                local SliderFill = Create("Frame", {
                    Parent = SliderBG, BackgroundColor3 = Theme.Accent, Size = UDim2.new((default - min) / (max - min), 0, 1, 0),
                    BorderSizePixel = 0
                })
                Create("UICorner", { Parent = SliderFill, CornerRadius = UDim.new(1, 0) })

                local function Update(input)
                    local pos = math.clamp((input.Position.X - SliderBG.AbsolutePosition.X) / SliderBG.AbsoluteSize.X, 0, 1)
                    local val = math.floor(min + ((max - min) * pos))
                    ValLbl.Text = tostring(val)
                    SliderFill.Size = UDim2.new(pos, 0, 1, 0)
                    callback(val)
                end

                local dragging = false
                SBtn.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = true
                        Update(input)
                    end
                end)
                UserInputService.InputChanged:Connect(function(input)
                    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                        Update(input)
                    end
                end)
                UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = false
                    end
                end)

                return {
                    SetValue = function(_, val)
                        val = math.clamp(val, min, max)
                        local pos = (val - min) / (max - min)
                        ValLbl.Text = tostring(val)
                        SliderFill.Size = UDim2.new(pos, 0, 1, 0)
                        callback(val)
                    end
                }
            end

