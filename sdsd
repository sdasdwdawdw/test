            local trashBody = Create("Frame", { Parent = TrashBtn, BackgroundColor3 = Theme.SecondaryText, BorderSizePixel = 0,
                Size = UDim2.new(0, 10, 0, 10), Position = UDim2.new(0.5, -5, 0, 7), ZIndex = 9 })
            Create("UICorner", { Parent = trashBody, CornerRadius = UDim.new(0, 2) })

            -- Load button
            local LoadBtn = Create("TextButton", {
                Parent = Card, BackgroundColor3 = Color3.fromRGB(45, 46, 58),
                Position = UDim2.new(1, -68, 0.5, -11), Size = UDim2.new(0, 56, 0, 22),
                Font = Theme.FontSemiBold, Text = "Load", TextSize = 12,
                TextColor3 = Theme.Text, AutoButtonColor = false, ZIndex = 8
            })
            Create("UICorner", { Parent = LoadBtn, CornerRadius = UDim.new(0, 4) })
            Create("UIStroke", { Parent = LoadBtn, Color = Color3.fromRGB(48, 49, 62), Thickness = 1 })

            -- Hover effects
            Card.MouseEnter:Connect(function()
                TweenService:Create(cardStroke, TweenInfo.new(0.15), { Color = Theme.Accent }):Play()
                TweenService:Create(Card, TweenInfo.new(0.15), { BackgroundColor3 = Color3.fromRGB(38, 39, 52) }):Play()
            end)
            Card.MouseLeave:Connect(function()
                TweenService:Create(cardStroke, TweenInfo.new(0.15), { Color = Color3.fromRGB(50, 52, 68) }):Play()
                TweenService:Create(Card, TweenInfo.new(0.15), { BackgroundColor3 = Color3.fromRGB(30, 31, 42) }):Play()
            end)
            EditBtn.MouseEnter:Connect(function()
                EditIcon.ImageColor3 = Theme.Text
            end)
            EditBtn.MouseLeave:Connect(function()
                EditIcon.ImageColor3 = Theme.SecondaryText
            end)
            TrashBtn.MouseEnter:Connect(function()
                local red = Color3.fromRGB(220, 80, 80)
                for _, ch in ipairs(TrashBtn:GetChildren()) do
                    if ch:IsA("Frame") then ch.BackgroundColor3 = red end
                    local st = ch:FindFirstChildOfClass("UIStroke"); if st then st.Color = red end
                end
            end)
            TrashBtn.MouseLeave:Connect(function()
                for _, ch in ipairs(TrashBtn:GetChildren()) do
                    if ch:IsA("Frame") then ch.BackgroundColor3 = Theme.SecondaryText end
                    local st = ch:FindFirstChildOfClass("UIStroke"); if st then st.Color = Theme.SecondaryText end
                end
            end)
            LoadBtn.MouseEnter:Connect(function() TweenService:Create(LoadBtn, TweenInfo.new(0.1), { BackgroundColor3 = Color3.fromRGB(55, 56, 72) }):Play() end)
            LoadBtn.MouseLeave:Connect(function() TweenService:Create(LoadBtn, TweenInfo.new(0.1), { BackgroundColor3 = Color3.fromRGB(45, 46, 58) }):Play() end)

            -- Selection and Load actions
            local function selectCard()
                selectedConfig = cfgName
                buildConfigCards() -- Refresh visual state
            end


            LoadBtn.MouseButton1Click:Connect(function()
                DeltaLib.ConfigSystem:Load(cfgName)
                pcall(function() writefile(DeltaLib.ConfigSystem.AutoLoadFile, cfgName) end)
                if DeltaLib.Notify then DeltaLib:Notify("Config | Load", "Config '" .. cfgName .. "' loaded!", 3) end
                buildConfigCards() -- Update selected state visual
            end)

            -- Edit/Rename action
            EditBtn.MouseButton1Click:Connect(function()
                -- Open modal pre-filled for rename
                editingConfigName = cfgName
                openModal(true)
            end)

            -- Delete action
            TrashBtn.MouseButton1Click:Connect(function()
                DeltaLib.ConfigSystem:Delete(cfgName)
                if DeltaLib.Notify then DeltaLib:Notify("Config | Delete", "Config '" .. cfgName .. "' deleted!", 3) end
                buildConfigCards()
            end)

        end

        if #configs == 0 then
            Create("TextLabel", {
                Parent = CardsList, BackgroundTransparency = 1,
                Size = UDim2.new(1, 0, 0, 100), Position = UDim2.new(0, 0, 0, 20),
                Font = Enum.Font.Gotham, Text = "No configurations found.",
                TextColor3 = Theme.SecondaryText, TextSize = 14,
                TextTransparency = 0.5, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 6
            })
        end
    end

    -- ===== CREATE CONFIG MODAL =====
    local ScreenGui = ConfigsTab.Frame:FindFirstAncestorOfClass("ScreenGui")
    ModalBG = Create("Frame", {
        Parent = ScreenGui, BackgroundColor3 = Color3.new(0, 0, 0),
        BackgroundTransparency = 0.5, Size = UDim2.new(1, 0, 1, 0),
        Visible = false, ZIndex = 100
    })

    local Modal = Create("Frame", {
        Parent = ModalBG, BackgroundColor3 = Color3.fromRGB(25, 26, 35),
        Size = UDim2.new(0, 280, 0, 170), AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, 0), ZIndex = 101
    })
    Create("UICorner", { Parent = Modal, CornerRadius = UDim.new(0, 10) })
    Create("UIStroke", { Parent = Modal, Color = Color3.fromRGB(60, 62, 80), Thickness = 1.2 })

    -- Modal title
    ModalTitle = Create("TextLabel", {
        Parent = Modal, BackgroundTransparency = 1,
        Position = UDim2.new(0, 16, 0, 12), Size = UDim2.new(1, -32, 0, 20),
        Font = Theme.Font, Text = "Create New Config", TextSize = 14,
        TextColor3 = Theme.Text, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 102
    })

    -- Config Name label
    Create("TextLabel", {
        Parent = Modal, BackgroundTransparency = 1,
        Position = UDim2.new(0, 16, 0, 42), Size = UDim2.new(1, -32, 0, 16),
        Font = Theme.FontSemiBold, Text = "Config Name", TextSize = 11,
        TextColor3 = Theme.SecondaryText, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 102
    })

    -- Config Name input
    ModalInput = Create("TextBox", {
        Parent = Modal, BackgroundColor3 = Color3.fromRGB(18, 19, 26),
        Position = UDim2.new(0, 16, 0, 62), Size = UDim2.new(1, -32, 0, 32),
        Font = Theme.FontSemiBold, Text = "", PlaceholderText = "Enter config name...",
        PlaceholderColor3 = Color3.fromRGB(80, 82, 100),
        TextColor3 = Theme.Text, TextSize = 12, ClearTextOnFocus = false,
        BorderSizePixel = 0, ZIndex = 102
    })
    Create("UICorner", { Parent = ModalInput, CornerRadius = UDim.new(0, 6) })
    Create("UIStroke", { Parent = ModalInput, Color = Color3.fromRGB(50, 52, 68), Thickness = 1 })
    Create("UIPadding", { Parent = ModalInput, PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) })

    -- Create Config button
    ModalCreateBtn = Create("TextButton", {
        Parent = Modal, BackgroundColor3 = Theme.Accent,
        Position = UDim2.new(0, 16, 0, 108), Size = UDim2.new(0.5, -20, 0, 32),
        Font = Theme.FontSemiBold, Text = "Create Config", TextSize = 12,
        TextColor3 = Color3.new(1,1,1), AutoButtonColor = false, ZIndex = 102
    })
    Create("UICorner", { Parent = ModalCreateBtn, CornerRadius = UDim.new(0, 6) })

    -- Cancel button
    local ModalCancelBtn = Create("TextButton", {
        Parent = Modal, BackgroundColor3 = Color3.fromRGB(45, 46, 58),
        Position = UDim2.new(0.5, 4, 0, 108), Size = UDim2.new(0.5, -20, 0, 32),
        Font = Theme.FontSemiBold, Text = "Cancel", TextSize = 12,
        TextColor3 = Theme.Text, AutoButtonColor = false, ZIndex = 102
    })
    Create("UICorner", { Parent = ModalCancelBtn, CornerRadius = UDim.new(0, 6) })

    -- Modal open/close
    function openModal(isRename)
        ModalInput.Text = editingConfigName or ""
        ModalTitle.Text = isRename and "Rename Config" or "Create New Config"
        ModalCreateBtn.Text = isRename and "Rename" or "Create Config"
        
        ModalBG.Visible = true
        ModalBG.BackgroundTransparency = 1
        TweenService:Create(ModalBG, TweenInfo.new(0.2), { BackgroundTransparency = 0.5 }):Play()
        local modalScale = Instance.new("UIScale"); modalScale.Parent = Modal; modalScale.Scale = 0.9
        TweenService:Create(modalScale, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
    end

    function closeModal()
        TweenService:Create(ModalBG, TweenInfo.new(0.15), { BackgroundTransparency = 1 }):Play()
        task.delay(0.15, function() ModalBG.Visible = false end)
    end

    -- Button hover effects
    for _, btn in ipairs({CreateBtn, RefreshBtn}) do
        btn.MouseEnter:Connect(function()
            TweenService:Create(btn, TweenInfo.new(0.15), { BackgroundColor3 = Color3.fromRGB(45, 46, 60) }):Play()
        end)
        btn.MouseLeave:Connect(function()
            TweenService:Create(btn, TweenInfo.new(0.15), { BackgroundColor3 = Color3.fromRGB(35, 36, 48) }):Play()
        end)
    end

    -- ===== ACTIONS =====
    CreateBtn.MouseButton1Click:Connect(function()
        editingConfigName = nil
        openModal(false)
    end)

    RefreshBtn.MouseButton1Click:Connect(function()
        buildConfigCards()
    end)

    ModalCancelBtn.MouseButton1Click:Connect(closeModal)
    ModalBG.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then closeModal() end
    end)

    ModalCreateBtn.MouseButton1Click:Connect(function()
        local name = ModalInput.Text:gsub("^%s+", ""):gsub("%s+$", "")
        if name ~= "" then
            if editingConfigName then
                -- Rename logic (move content)
                DeltaLib.ConfigSystem:Rename(editingConfigName, name)
                if DeltaLib.Notify then
                    DeltaLib:Notify("Config | Rename", "Successfully renamed '"..editingConfigName.."' to '"..name.."'", 3)
                end
                editingConfigName = nil -- Reset state after rename
            else
                -- Create logic
                DeltaLib.ConfigSystem:Save(name)
                if DeltaLib.Notify then
                    DeltaLib:Notify("Config | Save", "Successfully saved config: " .. name, 3)
                end
            end
            closeModal()
            task.delay(0.2, buildConfigCards) -- Small delay to allow file system sync
        else
            if DeltaLib.Notify then
                DeltaLib:Notify("Config | Warning", "Please enter a valid name!", 3)
            end
        end
    end)

    -- Initial build (delayed to ensure robustness)
    task.spawn(function()
        task.wait(1.5)
        buildConfigCards()
    end)
end

-- AutoLoad Logic (implace.txt implementation)
task.spawn(function()
    local lastConfig = Load("Text", "AutoLoadConfig.txt")
    if lastConfig and lastConfig ~= "" then
        if isfile(DeltaLib.ConfigSystem.Folder .. "/" .. lastConfig .. ".json") then
            task.wait(1) -- Wait for UI to stabilize
            DeltaLib.ConfigSystem:Load(lastConfig)
            if DeltaLib.Notify then 
                DeltaLib:Notify("Config | AutoLoad", "Loaded last used config: " .. lastConfig, 5) 
            end
        end
    end
end)

return DeltaLib
