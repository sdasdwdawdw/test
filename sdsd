local function GetInvTarget()
    local near = nil; local dist = math.huge
    local mouse = LocalPlayer:GetMouse(); local mousePos = Vector2.new(mouse.X, mouse.Y)

    local function check(model)
        if not model then return end
        local hrp = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Head")
        if hrp then
            local p2d, onScreen = Camera:WorldToViewportPoint(hrp.Position)
            if onScreen then
                local d = (Vector2.new(p2d.X, p2d.Y) - mousePos).Magnitude
                if d < dist and d < 1500 then
                    dist = d; near = model
                end
            end
        end
    end

    for _, p in pairs(game:GetService("Players"):GetPlayers()) do
        if p ~= LocalPlayer and p.Character then check(p.Character) end
    end
    if InvCheckSettings and InvCheckSettings.Features["Inventory Check Corpses"] then
        for _, c in pairs(game.Workspace.DroppedItems:GetChildren()) do
            if c:FindFirstChild("Humanoid") then check(c) end
        end
    end
    return near
end

local function formatNumber(v)
    local s = tostring(math.floor(v))
    return s:reverse():gsub("%d%d%d", "%1,"):reverse():gsub("^,", "")
end

local function GetInvValue(target)
    local list = game:GetService("ReplicatedStorage"):FindFirstChild("ItemsList")
    if not list then return 0 end
    
    local inv = target:FindFirstChild("Inventory") or (game.ReplicatedStorage.Players:FindFirstChild(target.Name) and game.ReplicatedStorage.Players[target.Name]:FindFirstChild("Inventory"))
    if not inv then return 0 end

    local totalVal = 0
    for _, item in pairs(inv:GetChildren()) do
        local slot = item:GetAttribute("Slot")
        if slot and slot:find("Clothing") and item:FindFirstChild("Inventory") then
            for _, inner in pairs(item.Inventory:GetChildren()) do
                if inner.Name == "Rubles" then
                    totalVal = totalVal + (inner:GetAttribute("Amount") or 1)
                else
                    local info = list:FindFirstChild(inner.Name)
                    if info then
                        local price = info.ItemProperties:GetAttribute("Price") or 1
                        if price >= 10 then
                            local itype = info.ItemProperties:GetAttribute("ItemType")
                            if itype == "Extra" then
                                price = price * 0.4
                            elseif itype == "Ammo" then
                                price = price * (inner:GetAttribute("Amount") or 1) * 0.7
                            elseif itype == "Clothing" then
                                price = price * 0.35
                            elseif itype == "Medical" then
                                price = price * 0.75
                            elseif itype == "Barter" then
                                price = price * 0.4
                            end
                        end
                        totalVal = totalVal + price
                    end
                end
            end
        end
    end
    return math.floor(totalVal)
end

local function FormatNumber(v)
    return tostring(v):reverse():gsub("%d%d%d", "%1,"):reverse():gsub("^,", "")
end

local function UpdateInvIcons(target)
    local list = game:GetService("ReplicatedStorage"):FindFirstChild("ItemsList")
    if not list then return end
    
    local inv = target:FindFirstChild("Inventory") or (game.ReplicatedStorage.Players:FindFirstChild(target.Name) and game.ReplicatedStorage.Players[target.Name]:FindFirstChild("Inventory"))
    if not inv then 
        InvValueTxt.Text = "VALUE: $0"
        for i=1, 12 do MainIcons[i].Image = EMPTY_ICON end
        for i=1, 12 do AttachIcons[i].Frame.Visible = false end
        for i=1, 54 do FullIcons[i].Image = EMPTY_ICON; FullLabels[i].Text = "" end
        return 
    end

    -- Reset icons
    for i=1, 12 do MainIcons[i].Image = EMPTY_ICON end
    for i=1, 12 do AttachIcons[i].Frame.Visible = false end
    for i=1, 54 do FullIcons[i].Image = EMPTY_ICON; FullLabels[i].Text = "" end

    local weaponSlot = 1; local clothesSlot = 4; local fullCount = 1
    local assigned = {}
    
    -- Pass 1: Assign Gear to Main Slots
    for _, item in pairs(inv:GetChildren()) do
        local info = list:FindFirstChild(item.Name)
        if info then
            local slotAttr = item:GetAttribute("Slot")
            local isWeapon = item:FindFirstChild("Attachments")
            local isClothes = slotAttr and slotAttr:find("Clothing")

            if isWeapon and weaponSlot <= 3 then
                MainIcons[weaponSlot].Image = info.ItemProperties.ItemIcon.Image
                assigned[item] = true
                local atts = item:FindFirstChild("Attachments")
                if atts then
                    for _, att in pairs(atts:GetChildren()) do
                        local attSlot = att:GetAttribute("Slot")
                        local attInfo = list:FindFirstChild(att.Name)
                        if attInfo then
                            local index = nil
                            if attSlot == "Magazine" then index = 1
                            elseif attSlot == "Sight" then index = 2
                            elseif attSlot == "Muzzle" then index = 3
                            elseif attSlot == "Extra" then index = 4
                            end
                            
                            if index then
                                local attachmentIcon = AttachIcons[(weaponSlot-1)*4 + index]
                                attachmentIcon.Icon.Image = attInfo.ItemProperties.ItemIcon.Image
                                attachmentIcon.Frame.Visible = true
                            end
                        end
                    end
                end
                weaponSlot = weaponSlot + 1
            elseif isClothes and clothesSlot <= 12 then
                MainIcons[clothesSlot].Image = info.ItemProperties.ItemIcon.Image
                assigned[item] = true
                clothesSlot = clothesSlot + 1
            end
        end
    end

    -- Pass 2: Fill Grid with Everything Else (Greedy)
    local function addToGrid(item)
        if fullCount > 54 then return end
        local info = list:FindFirstChild(item.Name)
        if info then
            FullIcons[fullCount].Image = info.ItemProperties.ItemIcon.Image
            local amt = item:GetAttribute("Amount") or 1
            FullLabels[fullCount].Text = amt >= 1000 and (math.floor(amt/1000).."K") or ("x"..amt)
            fullCount = fullCount + 1
        end

        local container = item:FindFirstChild("Inventory")
        if container and item.Name ~= "KeyChain" then
            for _, inner in pairs(container:GetChildren()) do
                addToGrid(inner)
            end
        end
    end

    for _, item in pairs(inv:GetChildren()) do
        if not assigned[item] then
            addToGrid(item)
        else
            -- If it was assigned (e.g. backpack), we still want to show its CONTENTS in the grid
            local container = item:FindFirstChild("Inventory")
            if container and item.Name ~= "KeyChain" then
                for _, inner in pairs(container:GetChildren()) do
                    addToGrid(inner)
                end
            end
        end
    end

    InvValueTxt.Text = "VALUE: $" .. FormatNumber(GetInvValue(target))
end


