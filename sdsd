toggleNoLandmines = function(v)
    WorldSettings.NoLandmines = v
    if NoLandminesConn then 
        NoLandminesConn:Disconnect()
        NoLandminesConn = nil
    end
    
    if v then
        local function clearMines(parent)
            if not parent then return end
            for _, obj in pairs(parent:GetChildren()) do
                if obj:IsA("Model") and (obj.Name == "PMN2" or obj.Name == "MON50") then
                    pcall(function() obj:Destroy() end)
                end
            end
        end
        
        local az = workspace:FindFirstChild("AiZones")
        if az then
            clearMines(az:FindFirstChild("Landmines"))
            clearMines(az:FindFirstChild("Claymores"))
            clearMines(az:FindFirstChild("OutpostLandmines"))
            clearMines(az:FindFirstChild("BridgeClaymores"))
        end
        
        NoLandminesConn = AddConnection(workspace.ChildAdded:Connect(function(obj)
            if WorldSettings.NoLandmines and obj:IsA("Model") and (obj.Name == "PMN2" or obj.Name == "MON50") then
                task.wait(2.5) -- Logic from implace.txt
                pcall(function() obj:Destroy() end)
            end
        end))
    end
end

toggleNoFog = function(v)
    WorldSettings.NoFog = v
    if NoFogConn then
        NoFogConn:Disconnect()
        NoFogConn = nil
    end

    if v then
        local function cleanFog()
            for _, obj in pairs(game:GetService("Lighting"):GetChildren()) do
                if obj:IsA("Atmosphere") or obj:IsA("Sky") then
                    if not obj:GetAttribute("OldEnabled") then
                        obj:SetAttribute("OldEnabled", obj:IsA("Atmosphere") and "atmos" or "sky")
                    end
                    if obj:IsA("Atmosphere") then obj.Parent = nil end
                end
            end
            game:GetService("Lighting").FogEnd = 100000
            game:GetService("Lighting").FogStart = 100000
        end
        
        cleanFog()
        NoFogConn = AddConnection(game:GetService("Lighting").ChildAdded:Connect(function(obj)
            if WorldSettings.NoFog and obj:IsA("Atmosphere") then
                task.wait()
                obj.Parent = nil
            end
        end))
    else
        game:GetService("Lighting").FogEnd = 1000 -- Approximate default
        game:GetService("Lighting").FogStart = 0
        -- Note: Restoring Atmosphere correctly might require a full reload or backup,
        -- but this provides the basic "fog back" experience.
    end
end

