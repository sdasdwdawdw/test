    -- CONFIG SYSTEM (AIRFLOW ARCHITECTURE)
    -- =============================================
    local ConfigSystem = {
        Folder = "DeltaConfigs",
        Registry = {},
        CurrentConfig = "none",
        AutoLoadFile = "DeltaConfigs/autoload.txt"
    }

    function ConfigSystem:GetConfigs()
        if not self or not self.Folder then self = ConfigSystem end
        if not isfolder(self.Folder) then makefolder(self.Folder) end
        local files = listfiles(self.Folder)
        local configs = {}
        for _, file in ipairs(files) do
            if file:sub(-5) == ".json" then
                local name = file:match("([^/\\]+)%.json$")
                if name then table.insert(configs, name) end
            end
        end
        return configs
    end

    function ConfigSystem:Delete(name)
        if not self or not self.Folder then self = ConfigSystem end
        if not delfile then return end
        local path = self.Folder .. "/" .. name .. ".json"
        
        -- Delete main config file
        if isfile(path) then
            pcall(function() delfile(path) end)
        end
        
        -- Clear AutoLoad pointers if they match the deleted config
        local function clearPointer(file)
            if isfile(file) then
                local content = readfile(file)
                if content == name or content:match("^" .. name .. "$") then
                    pcall(function() delfile(file) end)
                end
            end
        end
        
        pcall(function()
            clearPointer(self.AutoLoadFile)
            clearPointer("AutoLoadConfig.txt")
        end)
        
        -- Reset current config state if it matches the deleted name
        if self.CurrentConfig == name then
            self.CurrentConfig = "none"
        end
    end

    function ConfigSystem:Rename(oldName, newName)
        if not self or not self.Folder then self = ConfigSystem end
        if not readfile or not writefile or not delfile then return end
        if oldName == newName then return end
        
        local oldPath = self.Folder .. "/" .. oldName .. ".json"
        local newPath = self.Folder .. "/" .. newName .. ".json"
        
        if isfile(newPath) then
            if DeltaLib.Notify then DeltaLib:Notify("Config | Error", "Name already exists!", 3) end
            return
        end
        
        if isfile(oldPath) then
            local success, content = pcall(readfile, oldPath)
            if success then
                writefile(newPath, content)
                delfile(oldPath)
                
                -- Sync pointers
                local function updatePointer(file)
                    if isfile(file) then
                        if readfile(file) == oldName then
                            writefile(file, newName)
                        end
                    end
                end
                
                pcall(function()
                    updatePointer(self.AutoLoadFile)
                    updatePointer("AutoLoadConfig.txt")
                end)
                
                -- Sync active state
                if self.CurrentConfig == oldName then
                    self.CurrentConfig = newName
                end
            end
        end
    end

    function ConfigSystem:Save(name)
        if not self or not self.Folder then self = ConfigSystem end
        if not writefile then return end
        if not isfolder(self.Folder) then makefolder(self.Folder) end
        
        local data = {
            _timestamp = os.date("!%Y-%m-%dT%H:%M:%S.000Z"),
            Aimbot = AimbotSettings,
            SilentAim = SilentAimSettings,
            ESP = ESPSettings,
            Misc = MiscSettings,
            GunMods = GunModsSettings,
            World = WorldSettings,
            Player = PlayerFeatures,
            Detection = DetectionSettings,
            OtherESP = OtherESPSettings,
            Boss = BossSettings,
            InvCheck = InvCheckSettings
        }
        
        local function fixColors(t)
            local new = {}
            for k, v in pairs(t) do
                if typeof(v) == "Color3" then
                    new[k] = {v.R, v.G, v.B}
                elseif typeof(v) == "table" then
                    new[k] = fixColors(v)
                else
                    new[k] = v
                end
            end
            return new
        end
        
        local success, err = pcall(function()
            writefile(self.Folder .. "/" .. name .. ".json", HttpService:JSONEncode(fixColors(data)))
            -- Logic from implace.txt: save current config name to AutoLoadConfig.txt
            writefile(self.AutoLoadFile, name)
            Save(name, "AutoLoadConfig")
        end)
        
        if success then
            -- Success, but we don't set CurrentConfig here as per user request to keep new configs looking "default"
        else
            warn("Save error: "..tostring(err))
        end
    end

    function ConfigSystem:Load(name)
        if not self or not self.Folder then self = ConfigSystem end
        if not readfile or not isfile(self.Folder .. "/" .. name .. ".json") then return end
        
        local success, data = pcall(function()
            return HttpService:JSONDecode(readfile(self.Folder .. "/" .. name .. ".json"))
        end)
        
        if not success or not data then return end
        
        -- Logic from implace.txt: update AutoLoadConfig on load
        self.CurrentConfig = name
        writefile(self.AutoLoadFile, name)
        Save(name, "AutoLoadConfig")
        
        local function restoreSetting(target, source)
            for k, v in pairs(source) do
                if typeof(v) == "table" and #v == 3 and (typeof(v[1]) == "number" or tonumber(v[1])) then
                    target[k] = Color3.new(v[1], v[2], v[3])
                elseif typeof(v) == "table" then
                    if not target[k] then target[k] = {} end
                    restoreSetting(target[k], v)
                else
                    target[k] = v
                end
            end
        end

        restoreSetting(AimbotSettings, data.Aimbot or {})
        restoreSetting(SilentAimSettings, data.SilentAim or {})
        restoreSetting(ESPSettings, data.ESP or {})
        restoreSetting(MiscSettings, data.Misc or {})
        restoreSetting(GunModsSettings, data.GunMods or {})
        restoreSetting(WorldSettings, data.World or {})
        restoreSetting(PlayerFeatures, data.Player or {})
        restoreSetting(DetectionSettings, data.Detection or {})
        restoreSetting(OtherESPSettings, data.OtherESP or {})
        restoreSetting(BossSettings, data.Boss or {})
        restoreSetting(InvCheckSettings, data.InvCheck or {})

        -- Update UI Registry
        for key, obj in pairs(self.Registry) do
            local cat, kn = key:match("^(.-)_(.*)$")
            if cat and kn and data[cat] then
                local val = data[cat][kn]
                if typeof(val) == "table" and #val == 3 and (typeof(val[1]) == "number" or tonumber(val[1])) then
                    val = Color3.new(val[1], val[2], val[3]) 
                end
                
                if val ~= nil then
                    if typeof(val) == "Color3" then
                        if obj.SetColor then obj:SetColor(val) end
                    else
                        if obj.SetValue then
                            obj:SetValue(val)
                        elseif obj.SetState then
                            obj:SetState(val)
                        end
                    end
                end
            end
        end
        
        -- [[ LOGIC RESTORATION ]]
        -- UI Registry already triggers these via SetValue/SetState callbacks.
        -- We only manually call logic that is NOT directly tied to a UI element's callback.
        UpdateGunMods()
    end

    DeltaLib.ConfigSystem = ConfigSystem

    return DeltaLib
end

