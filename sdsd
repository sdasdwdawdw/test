                            if onRelease and Binds.Release[name] then
                                for i, cb in ipairs(Binds.Release[name]) do if cb == onRelease then table.remove(Binds.Release[name], i) break end end
                            end
                        end

                        if key == Enum.KeyCode.Escape or key == Enum.KeyCode.Unknown then
                            unregister(currentKey)
                            currentKey = Enum.KeyCode.Unknown
                            BindBox.Text = "[NONE]"
                        else
                            unregister(currentKey)
                            currentKey = key
                            local name = key.Name
                            
                            if not Binds.Press[name] then Binds.Press[name] = {} end
                            table.insert(Binds.Press[name], onPress)
                            
                            if onRelease then
                                if not Binds.Release[name] then Binds.Release[name] = {} end
                                table.insert(Binds.Release[name], onRelease)
                            end
                            
                            BindBox.Text = "[" .. name .. "]"
                        end
                        BindBox.TextColor3 = Theme.SecondaryText
                        isBinding = false
                    end
                end)
                return {
                    SetKey = function(_, key)
                        -- Reuse same unregister logic
                        if currentKey ~= Enum.KeyCode.Unknown then
                            local name = currentKey.Name
                            if Binds.Press[name] then for i, cb in ipairs(Binds.Press[name]) do if cb == onPress then table.remove(Binds.Press[name], i) break end end end
                            if onRelease and Binds.Release[name] then for i, cb in ipairs(Binds.Release[name]) do if cb == onRelease then table.remove(Binds.Release[name], i) break end end end
                        end
                        
                        currentKey = key or Enum.KeyCode.Unknown
                        if currentKey ~= Enum.KeyCode.Unknown then
                            local name = currentKey.Name
                            if not Binds.Press[name] then Binds.Press[name] = {} end
                            table.insert(Binds.Press[name], onPress)
                            if onRelease then
                                if not Binds.Release[name] then Binds.Release[name] = {} end
                                table.insert(Binds.Release[name], onRelease)
                            end
                            BindBox.Text = "[" .. name .. "]"
                        else
                            BindBox.Text = "[NONE]"
                        end
                    end
                }
            end

