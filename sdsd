toggleNoLeafs = function(v)
    WorldSettings.NoLeafs = v
    pcall(function()
        local foliagePath = workspace:FindFirstChild("SpawnerZones") and workspace.SpawnerZones:FindFirstChild("Foliage")
        if foliagePath then
            for _, obj in pairs(foliagePath:GetDescendants()) do
                if obj:IsA("SurfaceAppearance") or (obj:IsA("BasePart") and obj.Name == "Leafs") then
                    local part = obj:IsA("BasePart") and obj or obj.Parent
                    if part:IsA("BasePart") then
                        if v then
                            if not part:GetAttribute("OldTransparency") then
                                part:SetAttribute("OldTransparency", part.Transparency)
                            end
                            part.Transparency = 1
                        else
                            part.Transparency = part:GetAttribute("OldTransparency") or 0
                        end
                    end
                end
            end
        end
    end)
end

