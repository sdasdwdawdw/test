                    SetText = function(_, val)
                        Input.Text = val
                    end,
                    GetText = function()
                        return Input.Text
                    end
                }
            end


            function Items:Separator()
                itemCount = itemCount + 1
                local Container = Create("Frame", {
                    Parent = FeatureContent,
                    BackgroundTransparency = 1,
                    BorderSizePixel = 0,
                    Size = UDim2.new(1, 0, 0, 15), -- Total height with padding
                    LayoutOrder = itemCount
                })
                
                Create("Frame", {
                    Parent = Container,
                    BackgroundColor3 = Color3.fromRGB(60, 62, 80),
                    BorderSizePixel = 0,
                    Size = UDim2.new(1, 0, 0, 1),
                    Position = UDim2.new(0, 0, 0.5, 0), -- Centered line
                    BackgroundTransparency = 0.5
                })
                return Container
            end

            return Items
        end

        return TabObj
    end

