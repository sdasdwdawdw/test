    -- [[ SILENT AIM REDIRECTION HOOK ]]
    local hooking = false
    local function hook()
        if hookmetamethod then
            local oldNamecall
            oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
                local args = {...}
                local method = getnamecallmethod()
                
                if not hooking and SilentAimSettings.Enabled and (method == "Raycast" or method == "FindPartOnRayWithIgnoreList" or method == "FindPartOnRayWithWhitelist") then
                    hooking = true
                    local sTarget = getClosestTarget(SilentAimSettings)
                    if sTarget and sTarget.Character then
                        local sPart = sTarget.SelectedPart or resolveTargetPart(sTarget.Character, SilentAimSettings)
                        if sPart and args and args[1] then
                            local distLimit = SilentAimSettings.MaxDistance or 2000
                            if method == "Raycast" then
                                local origin = args[1]
                                local direction = (sPart.Position - origin).Unit * distLimit
                                if direction.X == direction.X then 
                                    hooking = false
                                    return oldNamecall(self, origin, direction, args[3])
                                end
                            elseif (method == "FindPartOnRayWithIgnoreList" or method == "FindPartOnRayWithWhitelist" or method == "FindPartOnRay") and typeof(args[1]) == "Ray" then
                                local rayOrigin = args[1].Origin
                                local direction = (sPart.Position - rayOrigin).Unit * distLimit
                                if direction.X == direction.X then
                                    hooking = false
                                    args[1] = Ray.new(rayOrigin, direction)
                                    return oldNamecall(self, unpack(args))
                                end
                            end
                        end
                    end
                    hooking = false
                end
                return oldNamecall(self, ...)
            end)
        elseif hookfunction and Workspace.Raycast then
            local oldRaycast
            oldRaycast = hookfunction(Workspace.Raycast, function(self, origin, direction, params)
                if not hooking and SilentAimSettings.Enabled then
                    hooking = true
                    local sTarget = getClosestTarget(SilentAimSettings)
                    if sTarget and sTarget.Character then
                        local sPart = sTarget.SelectedPart or resolveTargetPart(sTarget.Character, SilentAimSettings)
                        if sPart then
                            local dir = (sPart.Position - origin).Unit * (SilentAimSettings.MaxDistance or 2000)
                            if dir.X == dir.X then direction = dir end
                        end
                    end
                    hooking = false
                end
                return oldRaycast(self, origin, direction, params)
            end)
        end
    end

