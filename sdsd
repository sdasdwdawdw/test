local function UpdateGunMods()
    -- No Recoil
    pcall(function()
        if GunModsSettings.NoRecoil then
            for _, ammo in pairs(game:GetService("ReplicatedStorage").AmmoTypes:GetChildren()) do
                if not RecoilCache[tostring(ammo)] then
                    RecoilCache[tostring(ammo)] = ammo:GetAttribute("RecoilStrength")
                end
                ammo:SetAttribute("RecoilStrength", 0)
            end
        else
            for _, ammo in pairs(game:GetService("ReplicatedStorage").AmmoTypes:GetChildren()) do
                if RecoilCache[tostring(ammo)] then
                    ammo:SetAttribute("RecoilStrength", RecoilCache[tostring(ammo)])
                end
            end
            RecoilCache = {}
        end
    end)

    -- No Spread
    pcall(function()
        if GunModsSettings.NoSpread then
            for _, ammo in pairs(game:GetService("ReplicatedStorage").AmmoTypes:GetChildren()) do
                if not SpreadCache[ammo.Name] then
                    SpreadCache[ammo.Name] = {
                        AccuracyDeviation = ammo:GetAttribute("AccuracyDeviation"),
                        ProjectileDrop = ammo:GetAttribute("ProjectileDrop")
                    }
                end
                if ammo:GetAttribute("AccuracyDeviation") ~= nil then
                    ammo:SetAttribute("AccuracyDeviation", 0)
                end
                if ammo:GetAttribute("ProjectileDrop") ~= nil then
                    ammo:SetAttribute("ProjectileDrop", 0)
                end
            end
        else
            for _, ammo in pairs(game:GetService("ReplicatedStorage").AmmoTypes:GetChildren()) do
                if SpreadCache[ammo.Name] then
                    local originalData = SpreadCache[ammo.Name]
                    if originalData.AccuracyDeviation ~= nil then
                        ammo:SetAttribute("AccuracyDeviation", originalData.AccuracyDeviation)
                    end
                    if originalData.ProjectileDrop ~= nil then
                        ammo:SetAttribute("ProjectileDrop", originalData.ProjectileDrop)
                    end
                end
            end
            SpreadCache = {}
        end
    end)
end

